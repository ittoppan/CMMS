[TEMPLATE]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cmms_tpt
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_NAME=CMMS-TPT
APP_ENV=development
APP_DEBUG=true

# Base URL สำหรับใช้ในลิงก์ที่ส่งใน LINE/Email (ต้องเป็น HTTPS ของ production)
# APP_URL=https://cmms.example.com

# Origin ที่อนุญาตให้เรียก API เพื่ออ่านข้อมูล (ระบุได้หลายค่า คั่นด้วยเครื่องหมายจุลภาค หรือใช้ wildcard *)
# ตัวอย่าง: อนุญาต loopback + private LAN IP + *.ngrok-free.app / *.ngrok.io / *.trycloudflare.com
# ALLOWED_ORIGINS=*.ngrok-free.app,*.shares.zrok.io,https://cmms.example.com

# (Dev เท่านั้น) ดึง tunnel URL จาก log ของ cloudflared / ผ่าน ngrok local API
# CLOUDFLARE_LOG_PATH=C:\cloudflared\cf_tunnel_err.log
# NGROK_ENABLED=1

# Origins ที่อนุญาตให้ Next.js dev server เชื่อมต่อ (ใช้ใน next.config.ts -> allowedDevOrigins)
# คั่นด้วย comma ตัวอย่าง: 127.0.0.1,localhost,192.168.x.x,*.ngrok-free.app,*.trycloudflare.com
# ALLOWED_DEV_ORIGINS=127.0.0.1,localhost,*.trycloudflare.com,*.shares.zrok.io

# LINE Login & LIFF Configuration (ngrok HTTPS Tunnel)
LINE_CHANNEL_ID=YOUR_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_CALLBACK_URL=https://YOUR_PUBLIC_HOST/line_callback.php
LINE_LIFF_ID=YOUR_LINE_LIFF_ID

# LIFF App แยกสำหรับหน้า /register (ถ้าไม่ตั้ง ระบบจะ fallback ไป LINE_LIFF_ID)
# LINE_LIFF_REGISTER_ID=YOUR_LINE_LIFF_REGISTER_ID

# LINE Messaging API (channel id/secret สำหรับ webhook/ตอบกลับ — ถ้าเปิดใช้)
# LINE_CLIENT_ID=YOUR_LINE_LOGIN_CHANNEL_ID
# LINE_MESSAGING_CHANNEL_SECRET=YOUR_LINE_MESSAGING_CHANNEL_SECRET

# LINE Notify (legacy — LINE ปิดบริการแล้ว 2025; เก็บไว้เพื่อความเข้ากันได้ของโค้ดเดิม)
# LINE_NOTIFY_TOKEN=

# ---------------------------------------------------------------
# Telegram (สคริปต์แจ้งเตือน/automation — scripts/alert_check.php ฯลฯ)
# ---------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------
# พอร์ต Next.js ที่ PHP redirect ไป (public/index.php -> /dashboard) — default 3001
# NEXTJS_PORT=3001

# ---------------------------------------------------------------
# Sage 300 (อ่านข้อมูลผ่าน ODBC — ตั้งเฉพาะเครื่องที่เชื่อม Sage)
# ---------------------------------------------------------------
# SAGE300_DSN=
# SAGE300_ODBC_DSN=
# SAGE300_USER=
# SAGE300_PASS=
# SAGE300_DB_USER=
# SAGE300_DB_PASS=

# ---------------------------------------------------------------
# System Services page (/api/v1/system_services.php) — override ได้ถ้าเครื่องจริงต่างจาก default
# ---------------------------------------------------------------
# API_PORT=8081
# MYSQL_PORT=3306
# MYSQL_SERVICE=MySQL80
# IIS_SITE_NAME=cmms-tpt
# APP_ROOT=C:/inetpub/wwwroot/cmms-tpt
# NODE_EXE=node
# NODE_LOG_DIR=C:/Users/<user>/AppData/Local/Temp
# NGROK_EXE=C:/ngrok/ngrok.exe
# NGROK_API_URL=http://127.0.0.1:4040
# ZROK_API_URL=http://127.0.0.1:9191
# CLOUDFLARED_EXE=C:/cloudflared/cloudflared.exe
# CLOUDFLARED_LOG=C:/cloudflared/cf_tunnel_err.log
# CLOUDFLARED_OUT=C:/cloudflared/cf_tunnel_out.log

# ---------------------------------------------------------------
# Reports: สร้าง index อัตโนมัติ (ปกติไม่ต้องเปิด — สร้างครั้งเดียวผ่าน CLI)
# ---------------------------------------------------------------
# REPORTS_AUTO_INDEX=0
