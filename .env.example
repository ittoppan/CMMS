[TEMPLATE]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cmms_tpt
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_NAME=CMMS-TPT
APP_ENV=development
APP_DEBUG=true

# Base URL ของระบบสำหรับใช้ในลิงก์แจ้งเตือน (LINE/Email) — ตั้งค่านี้ใน production
# APP_URL=https://cmms.example.com

# Origin ที่อนุญาตให้เรียก API ที่เปลี่ยนข้อมูลได้ (คั่นด้วย , รองรับ wildcard *.)
# ค่าเริ่มต้นครอบคลุม loopback + private LAN IP + *.ngrok-free.app / *.ngrok.io / *.trycloudflare.com
# ALLOWED_ORIGINS=*.ngrok-free.app,https://cmms.example.com

# (Dev เท่านั้น) อ่าน tunnel URL จากไฟล์ log ของ cloudflared / เปิดอ่าน ngrok local API
# CLOUDFLARE_LOG_PATH=C:\cloudflared\cf_tunnel_err.log
# NGROK_ENABLED=1

# LINE Login & LIFF Configuration (ngrok HTTPS Tunnel)
LINE_CHANNEL_ID=YOUR_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_CALLBACK_URL=https://YOUR_PUBLIC_HOST/line_callback.php
LINE_LIFF_ID=YOUR_LINE_LIFF_ID
