[TEMPLATE]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cmms_tpt
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

APP_NAME=CMMS-TPT
APP_ENV=development
APP_DEBUG=true

# Base URL สำหรับใช้ในลิงก์ที่ส่งใน LINE/Email (ต้องเป็น HTTPS ของ production)
# APP_URL=https://cmms.example.com

# Origin ที่อนุญาตให้เรียก API เพื่ออ่านข้อมูล (ระบุได้หลายค่า คั่นด้วยเครื่องหมายจุลภาค หรือใช้ wildcard *)
# ตัวอย่าง: อนุญาต loopback + private LAN IP + *.ngrok-free.app / *.ngrok.io / *.trycloudflare.com
# ALLOWED_ORIGINS=*.ngrok-free.app,https://cmms.example.com

# (Dev เท่านั้น) ดึง tunnel URL จาก log ของ cloudflared / ผ่าน ngrok local API
# CLOUDFLARE_LOG_PATH=C:\cloudflared\cf_tunnel_err.log
# NGROK_ENABLED=1

# Origins ที่อนุญาตให้ Next.js dev server เชื่อมต่อ (ใช้ใน next.config.ts -> allowedDevOrigins)
# คั่นด้วย comma ตัวอย่าง: 127.0.0.1,localhost,192.168.x.x,*.ngrok-free.app,*.trycloudflare.com
# ALLOWED_DEV_ORIGINS=127.0.0.1,localhost,*.trycloudflare.com

# LINE Login & LIFF Configuration (ngrok HTTPS Tunnel)
LINE_CHANNEL_ID=YOUR_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_CALLBACK_URL=https://YOUR_PUBLIC_HOST/line_callback.php
LINE_LIFF_ID=YOUR_LINE_LIFF_ID