#!/usr/bin/env bash
#
# pre-push hook — กัน gradient / banned-hex / emoji / eyebrow แหก guideline ขึ้น remote
#
# ทำงาน: python scripts/design-audit.py --diff <base> --strict
#   base = remote SHA (เทียบเฉพาะไฟล์ที่จะ push) / origin/main ถ้า push branch ใหม่
#   audit จะ FAIL ถ้าไฟล์ที่เปลี่ยนมี gradient, hex banned หรือ WARN (--strict)
#
# ติดตั้ง (ทุก clone ที่จะ push):
#   git config core.hooksPath scripts/git-hooks
#
# ข้ามได้ชั่วคราว (ไม่แนะนำ): git push --no-verify

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
AUDIT="$REPO_ROOT/scripts/design-audit.py"

if [ ! -f "$AUDIT" ]; then
  echo "[pre-push] ⚠️ ไม่พบ scripts/design-audit.py — ข้ามการตรวจ"
  exit 0
fi

FAILED=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$local_ref" ] && continue

  # ข้ามการลบ branch (local oid เป็น 0 ทั้งหมด)
  if echo "$local_oid" | grep -qE "^0+$"; then
    continue
  fi

  # อัปเดต tracking ref ก่อนคำนวณ base — กันใช้ remote_oid ที่ stale
  git fetch --quiet origin main 2>/dev/null || true

  # ใช้ origin/main (ล่าสุด) เป็น base เสมอ เพื่อให้ diff ครอบคลุมเฉพาะไฟล์ที่ยังไม่ merge
  # (remote_oid เก่ากว่า fix commits ทำให้ finding เดิมถูกฟ้องซ้ำ)
  if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    base="origin/main"
  elif echo "$remote_oid" | grep -qE "^0+$"; then
    base="HEAD"
  else
    base="$remote_oid"
  fi

  echo ""
  echo "[pre-push] design-audit --diff $base --strict  (ไฟล์ที่จะ push: $local_ref)"
  if ! python "$AUDIT" --diff "$base" --strict; then
    echo "[pre-push] ❌ BLOCKED: ดีไซน์ไม่ตรง guideline — แก้ตาม FAIL/WARN ด้านบนก่อน push"
    FAILED=1
  fi
done

# ── PHP unit tests (เร็ว, ไม่ใช้ DB) — รันก่อน tsc/next build เพื่อให้รู้ผลเร็ว ──
# รายการชุดทดสอบรวมอยู่ที่ scripts/php-unit-tests.sh (ไฟล์เดียวกับที่ CI เรียก)
# ครอบคลุมกติกา reset ของ PM reminder (pm_reminders_should_reset) และ xlsx writer/reader
PHP_TESTS="$REPO_ROOT/scripts/php-unit-tests.sh"
if [ -f "$PHP_TESTS" ] && command -v php >/dev/null 2>&1; then
  echo ""
  echo "[pre-push] php unit tests (bash scripts/php-unit-tests.sh)"
  if ! bash "$PHP_TESTS"; then
    echo "[pre-push] ❌ BLOCKED: ชุดทดสอบ PHP ไม่ผ่าน — แก้ให้เทสต์ผ่านก่อน push"
    FAILED=1
  fi
elif [ ! -f "$PHP_TESTS" ]; then
  echo "[pre-push] ⚠️ ไม่พบ scripts/php-unit-tests.sh — ข้ามการตรวจชุดทดสอบ PHP"
else
  echo "[pre-push] ⚠️ ไม่พบ php ใน PATH — ข้ามการตรวจชุดทดสอบ PHP"
fi

# ── PHP static analysis: PHPStan level 3 + baseline (phpstan.neon) ──
# ต้องมี vendor/bin/phpstan (composer install) — ไม่มีจะข้ามพร้อมคำเตือน
# หนี้เดิม 60 รายการถูกล็อกใน phpstan-baseline.neon; โค้ดใหม่ต้องสะอาด
PHPSTAN_CHECK="$REPO_ROOT/scripts/phpstan-check.sh"
if [ -f "$PHPSTAN_CHECK" ]; then
  echo ""
  echo "[pre-push] phpstan (level 3 + baseline)"
  if ! bash "$PHPSTAN_CHECK"; then
    echo "[pre-push] ❌ BLOCKED: PHPStan พบ error — แก้โค้ดก่อน push"
    FAILED=1
  fi
else
  echo "[pre-push] ⚠️ ไม่พบ scripts/phpstan-check.sh — ข้ามการตรวจ PHPStan"
fi

# ── TypeScript check: บังคับ 0 error (ล้าง debt ครบแล้ว ไม่มี baseline) ──
TSC_CHECK="$REPO_ROOT/scripts/tsc-check.sh"
if [ -f "$TSC_CHECK" ]; then
  echo ""
  echo "[pre-push] tsc --noEmit (บังคับ 0 error)"
  if ! bash "$TSC_CHECK"; then
    echo "[pre-push] ❌ BLOCKED: มี TypeScript error — แก้ให้ครบ 0 ก่อน push"
    FAILED=1
  fi
else
  echo "[pre-push] ⚠️ ไม่พบ scripts/tsc-check.sh — ข้ามการตรวจ TypeScript"
fi

# ── Next build check: จับ build พัง (Turbopack parse error) ที่ tsc ตรวจไม่เจอ ──
# เหตุการณ์ 2026-08-30: build fail (Unterminated regexp) → .next ไม่มี standalone
#   → :3001 ล่ม → เข้าใช้งานระบบไม่ได้ แต่ tsc ผ่านเพราะไม่ได้ตรวจ parse/build
NEXT_BUILD_CHECK="$REPO_ROOT/scripts/next-build-check.sh"
if [ -f "$NEXT_BUILD_CHECK" ]; then
  echo ""
  echo "[pre-push] next build (output:standalone) — กัน deploy พัง"
  if ! bash "$NEXT_BUILD_CHECK"; then
    echo "[pre-push] ❌ BLOCKED: next build/standalone ไม่ผ่าน — แก้ให้ build สำเร็จก่อน push"
    FAILED=1
  fi
else
  echo "[pre-push] ⚠️ ไม่พบ scripts/next-build-check.sh — ข้ามการตรวจ next build"
fi

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "[pre-push] 🚫 push ถูกยกเลิก — แก้ให้ audit ผ่าน แล้ว push ใหม่"
  echo "[pre-push]    (ข้ามชั่วคราวได้ด้วย: git push --no-verify — ไม่แนะนำ)"
  exit 1
fi

exit 0
