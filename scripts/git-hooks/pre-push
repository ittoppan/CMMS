#!/usr/bin/env bash
#
# pre-push hook — กัน gradient / banned-hex / emoji / eyebrow แหก guideline ขึ้น remote
#
# ทำงาน: python scripts/design-audit.py --diff <base> --strict
#   base = remote SHA (เทียบเฉพาะไฟล์ที่จะ push) / origin/main ถ้า push branch ใหม่
#   audit จะ FAIL ถ้าไฟล์ที่เปลี่ยนมี gradient, hex banned หรือ WARN (--strict)
#
# ติดตั้ง (ทุก clone ที่จะ push):
#   git config core.hooksPath scripts/git-hooks
#
# ข้ามได้ชั่วคราว (ไม่แนะนำ): git push --no-verify

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
AUDIT="$REPO_ROOT/scripts/design-audit.py"

if [ ! -f "$AUDIT" ]; then
  echo "[pre-push] ⚠️ ไม่พบ scripts/design-audit.py — ข้ามการตรวจ"
  exit 0
fi

FAILED=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "$local_ref" ] && continue

  # ข้ามการลบ branch (local oid เป็น 0 ทั้งหมด)
  if echo "$local_oid" | grep -qE "^0+$"; then
    continue
  fi

  # push branch ใหม่ (remote oid เป็น 0) → เทียบกับ origin/main (ถ้ามี)
  if echo "$remote_oid" | grep -qE "^0+$"; then
    if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
      base="origin/main"
    else
      base="HEAD"
    fi
  else
    base="$remote_oid"
  fi

  echo ""
  echo "[pre-push] design-audit --diff $base --strict  (ไฟล์ที่จะ push: $local_ref)"
  if ! python "$AUDIT" --diff "$base" --strict; then
    echo "[pre-push] ❌ BLOCKED: ดีไซน์ไม่ตรง guideline — แก้ตาม FAIL/WARN ด้านบนก่อน push"
    FAILED=1
  fi
done

# ── TypeScript check: บังคับ 0 error (ล้าง debt ครบแล้ว ไม่มี baseline) ──
TSC_CHECK="$REPO_ROOT/scripts/tsc-check.sh"
if [ -f "$TSC_CHECK" ]; then
  echo ""
  echo "[pre-push] tsc --noEmit (บังคับ 0 error)"
  if ! bash "$TSC_CHECK"; then
    echo "[pre-push] ❌ BLOCKED: มี TypeScript error — แก้ให้ครบ 0 ก่อน push"
    FAILED=1
  fi
else
  echo "[pre-push] ⚠️ ไม่พบ scripts/tsc-check.sh — ข้ามการตรวจ TypeScript"
fi

# ── Next build check: จับ build พัง (Turbopack parse error) ที่ tsc ตรวจไม่เจอ ──
# เหตุการณ์ 2026-08-30: build fail (Unterminated regexp) → .next ไม่มี standalone
#   → :3001 ล่ม → เข้าใช้งานระบบไม่ได้ แต่ tsc ผ่านเพราะไม่ได้ตรวจ parse/build
NEXT_BUILD_CHECK="$REPO_ROOT/scripts/next-build-check.sh"
if [ -f "$NEXT_BUILD_CHECK" ]; then
  echo ""
  echo "[pre-push] next build (output:standalone) — กัน deploy พัง"
  if ! bash "$NEXT_BUILD_CHECK"; then
    echo "[pre-push] ❌ BLOCKED: next build/standalone ไม่ผ่าน — แก้ให้ build สำเร็จก่อน push"
    FAILED=1
  fi
else
  echo "[pre-push] ⚠️ ไม่พบ scripts/next-build-check.sh — ข้ามการตรวจ next build"
fi

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "[pre-push] 🚫 push ถูกยกเลิก — แก้ให้ audit ผ่าน แล้ว push ใหม่"
  echo "[pre-push]    (ข้ามชั่วคราวได้ด้วย: git push --no-verify — ไม่แนะนำ)"
  exit 1
fi

exit 0
