node_modules/
vendor/
.env
frontend/.env.local
*.log

# Runtime data (watchdog, tunnel, pids)
logs/

# Next.js build artifacts
frontend/.next/
frontend/tsconfig.tsbuildinfo
# Next.js generates this per-build (path depends on the distDir used last) — untracked
frontend/next-env.d.ts

# OpenWork app data (chat attachments, inbox)
.opencode/openwork/

# Astryx design-system source (vendored copy — not used at runtime; installed via npm @astryxdesign/*)
astryx-main/

# Freebuff worktrees (internal)
.freebuff/

# Playwright e2e artifacts
frontend/test-results/
frontend/playwright-report/
# alternate build dir (NEXT_DIST_DIR escape hatch)
frontend/.next-verify/
# pre-push build-validation dir (next-build-check.sh) — แยกจาก .next ที่ server ใช้
frontend/.next-verify-check/

# Third-party agent skills (install via npx skills add, do not commit)
.agents/skills/

# visual regression baselines (local artifacts)
visual-baseline/

# transient e2e fixture creds
frontend/.e2e-auth.json

# OS / editor junk
Thumbs.db
.DS_Store
~$*

# Playwright / audit scratch (repo root)
test-results/
playwright-report/

# opencode tooling (project skills, design-extract scratch, lock)
# Third-party agent skills (install via npx skills add, do not commit)
.agents/skills/
.extract-design-system/
skills-lock.json

# Sensitive local copies (DB dumps, backups) — อย่า commit
backups/

# runtime placeholder avatars
public/uploads/spares/placeholders/

# เอกสารฟอร์มเก่า (Excel/Word/PDF) ใน docs/EN — เก็บไว้บนดิสก์ ไม่ track ลง git
docs/EN/*.xls*
docs/EN/*.od?
docs/EN/*.docx
docs/EN/*.pdf
docs/EN/*.doc

# Playwright MCP audit scratch
.playwright-mcp/
